rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'ADMIN';
    }

    function isFieldOfficer() {
      return isAuthenticated() && getUserData().role == 'FIELD_OFFICER';
    }

    function isDriver() {
      return isAuthenticated() && getUserData().role == 'DRIVER';
    }

    // Collection 1: users/{uid}
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isUser(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if false;
    }

    // Collection 2: incident_reports/{reportId}
    match /incident_reports/{reportId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.officerId == request.auth.uid || isDriver());
      allow create: if isAuthenticated() && isFieldOfficer() && request.resource.data.officerId == request.auth.uid;
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if false;
    }

    // Collection 3: ai_analysis/{analysisId}
    match /ai_analysis/{analysisId} {
      allow read: if isAuthenticated();
      allow write: if false; // AI Engine writes via Firebase Admin SDK
    }

    // Collection 4: routes/{routeId}
    match /routes/{routeId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdmin() || isDriver());
      allow create, delete: if false; // Created via Server / AI Engine / RouteGuard
    }

    // Collection 5: tracking/{trackingId}
    match /tracking/{trackingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isDriver() || request.resource.data.driverId == request.auth.uid);
      allow update, delete: if false;
    }
  }
}
