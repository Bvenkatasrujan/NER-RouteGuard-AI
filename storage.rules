rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Incident Report Photo Uploads
    match /incident_reports/{incidentId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // User Profile and License Photo Uploads
    match /user_documents/{uid}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default read for authenticated users
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}

